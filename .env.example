# ==============================================================================
# CANDA ADS AGENTIC DATING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Path
DATABASE_PATH=data/agentic_dating.db

# Apify Scraping Configuration (Optional: system uses verified dataset and fallback if unsupplied)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_ACTOR_ID=curious_coder/linkedin-profile-scraper
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-profile-scraper

# LLM Provider Configuration ('deterministic' | 'openai' | 'anthropic' | 'gemini')
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
